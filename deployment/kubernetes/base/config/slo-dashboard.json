  "panels": [
    {
      "id": 1,
      "title": "Search success (24h)",
      "type": "stat",
      "description": "Provisional goal: at least 99% successful monitored GET /jobs requests over 24 hours; undefined without traffic. Alerting requires at least 100 requests.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "100 * job_market:search_availability:ratio24h",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
