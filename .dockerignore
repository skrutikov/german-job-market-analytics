.github
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.cache
*.egg-info
.env
.env.*
!.env.example
.ssh
*.pem
*.key
*.p12
*.pfx
*.tfstate
*.tfstate.*
**/.terraform
deployment/performance/results
deployment/security/results

deployment/
